generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// CORE SYSTEM & MULTI-TENANCY
// ---------------------------------------------------------

model Tenant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String // e.g. "College of Engineering", "Main University"
  domain    String?  @unique // e.g. "engineering.university.edu"
  isMaster  Boolean  @default(false) // True for University Headquarters Super Admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  // Roles & Users
  tenantRoles       TenantRole[]
  tenantPermissions TenantPermission[]
  tenantUserRoles   TenantUserRole[]
  tenantSuperAdmin  TenantSuperAdmin?

  // Audits
  tenantAuditLogs      TenantAuditLog[]
  roleChangeAudits     RoleChangeAudit[]
  departments          Department[]
  classes              Class[]
  terms                Term[]
  subscription         Subscription?
  Attendance           Attendance[]
  Exam                 Exam[]
  StudentGrade         StudentGrade[]
  Assignment           Assignment[]
  AssignmentSubmission AssignmentSubmission[]
  Announcement         Announcement[]
  Payment              Payment[]
  SalaryPayment        SalaryPayment[]
  Expense              Expense[]
}

// ---------------------------------------------------------
// AUTHENTICATION & RBAC (TWO-TIER SUPER ADMIN ARCHITECTURE)
// ---------------------------------------------------------

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SaaS Level Super Admin flag
  saasSuperAdmin SaaSSuperAdmin?

  // Tenant Level Super Admin flag
  tenantSuperAdmin TenantSuperAdmin?

  // Tenant-scoped Roles
  tenantRoles TenantUserRole[]

  // Action actor references
  tenantAuditLogs TenantAuditLog[]

  // Profile Relations
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  staffProfile   StaffProfile?
  SalaryPayment  SalaryPayment[]
}

// Global Level - Only for SaaS super admin
model SaaSRole {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String // "SAAS_SUPER_ADMIN"
  description String
}

model SaaSSuperAdmin {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedWith String[] // Email addresses given access
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TenantSuperAdmin {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String   @unique @db.ObjectId
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String   @unique @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedWith String[] // Email addresses of people who know the password
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Tenant Level - Each tenant has own roles
model TenantRole {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String  @db.ObjectId
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // e.g., "FINANCE_ADMIN", "DEPARTMENT_HEAD"
  displayName String // User-friendly name
  description String
  color       String?

  permissions TenantRolePermission[]
  userRoles   TenantUserRole[]
  roleChanges RoleChangeAudit[]

  createdBy String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

// Tenant-level permissions
model TenantPermission {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action   String // CREATE, READ, UPDATE, DELETE, APPROVE
  subject  String // STUDENTS, FEES, TEACHERS, REPORTS, DEPARTMENTS
  scope    String // ALL, DEPARTMENT, OWN_ONLY

  description String?

  roles TenantRolePermission[]

  createdAt DateTime @default(now())

  @@unique([tenantId, action, subject, scope])
}

// Junction table for Roles and Permissions
model TenantRolePermission {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String           @db.ObjectId
  role         TenantRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String           @db.ObjectId
  permission   TenantPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// Tenant-scoped user-role assignment
model TenantUserRole {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String     @db.ObjectId
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String     @db.ObjectId
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId   String     @db.ObjectId
  role     TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  expiresAt DateTime?

  assignedBy String   @db.ObjectId
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, userId, roleId])
}

// ---------------------------------------------------------
// USER PROFILES
// ---------------------------------------------------------

model TeacherProfile {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  userId   String    @unique @db.ObjectId
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects Subject[]
}

model StaffProfile {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @unique @db.ObjectId
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle String
}

model ParentProfile {
  id       String           @id @default(auto()) @map("_id") @db.ObjectId
  userId   String           @unique @db.ObjectId
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentProfile[]
}

model StudentProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nationality String?
  imageUrl    String?
  address     String?
  pinCode     String?
  state       String?
  country     String?
  gender      String?
  dob         DateTime?

  parentId String?        @db.ObjectId
  parent   ParentProfile? @relation(fields: [parentId], references: [id])

  classId String? @db.ObjectId
  class   Class?  @relation(fields: [classId], references: [id])

  streamId String? @db.ObjectId
  stream   Stream? @relation(fields: [streamId], references: [id])

  payments             Payment[]
  Attendance           Attendance[]
  StudentGrade         StudentGrade[]
  AssignmentSubmission AssignmentSubmission[]
}

// ---------------------------------------------------------
// ACADEMICS
// ---------------------------------------------------------

model Department {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  tenantId  String    @db.ObjectId
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, tenantId])
}

model Subject {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  code         String?
  departmentId String          @db.ObjectId
  department   Department      @relation(fields: [departmentId], references: [id])
  teacherId    String?         @db.ObjectId
  teacher      TeacherProfile? @relation(fields: [teacherId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([code, departmentId])
}

model Term {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String // e.g. "Term 1"
  year      Int // e.g. 2025
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  tenantId  String   @db.ObjectId
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fees      Fee[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  tenantId   String           @db.ObjectId
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  streams    Stream[]
  students   StudentProfile[]
  fees       Fee[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  Attendance Attendance[]
  Exam       Exam[]
  Assignment Assignment[]

  @@unique([name, tenantId])
}

model Stream {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  classId    String           @db.ObjectId
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  students   StudentProfile[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  Attendance Attendance[]

  @@unique([name, classId])
}

// ---------------------------------------------------------
// FINANCE
// ---------------------------------------------------------

model Fee {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String    @db.ObjectId
  classId   String    @db.ObjectId
  class     Class     @relation(fields: [classId], references: [id])
  termId    String    @db.ObjectId
  term      Term      @relation(fields: [termId], references: [id])
  items     FeeItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FeeItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  amount    Float
  feeId     String   @db.ObjectId
  fee       Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String         @db.ObjectId
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String         @db.ObjectId
  student     StudentProfile @relation(fields: [studentId], references: [id])
  amount      Float
  status      String // e.g. PENDING, PAID
  prn         String         @unique // The generated Payment Reference Number
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ---------------------------------------------------------
// SUPER ADMIN & SYSTEM
// ---------------------------------------------------------

model Subscription {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String    @unique @db.ObjectId
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         String // "Starter", "Professional", "Enterprise"
  status       String // "ACTIVE", "TRIAL", "CANCELLED", "PAST_DUE"
  billingCycle String // "MONTHLY", "YEARLY"
  startDate    DateTime  @default(now())
  endDate      DateTime?
  amount       Float
  currency     String    @default("USD")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TenantAuditLog {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String  @db.ObjectId
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action       String // CREATE, UPDATE, DELETE, LOGIN
  resourceType String // USER, ROLE, DEPARTMENT
  resourceId   String?
  actorId      String  @db.ObjectId
  actor        User    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  changes   String? // JSON: before/after values
  ipAddress String?
  userAgent String?
  status    String // SUCCESS, FAILED

  createdAt DateTime @default(now())
}

model RoleChangeAudit {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String     @db.ObjectId
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId   String     @db.ObjectId
  role     TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  action String // CREATED, UPDATED, DELETED

  previousPermissions String? // JSON
  newPermissions      String? // JSON

  changedBy String   @db.ObjectId
  changedAt DateTime @default(now())
}

model SystemSettings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String // JSON or string value
  description String?
  isPublic    Boolean  @default(false)
  updatedBy   String?  @db.ObjectId
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId String         @db.ObjectId
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String @db.ObjectId
  class   Class  @relation(fields: [classId], references: [id])

  streamId String? @db.ObjectId
  stream   Stream? @relation(fields: [streamId], references: [id])

  date    DateTime         @default(now())
  status  AttendanceStatus
  remarks String?

  markedBy String   @db.ObjectId
  markedAt DateTime @default(now())

  @@unique([studentId, date])
}

model Exam {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  date DateTime

  classId String @db.ObjectId
  class   Class  @relation(fields: [classId], references: [id])

  subject  String
  maxScore Float

  grades StudentGrade[]

  createdBy String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentGrade {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  examId String @db.ObjectId
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  studentId String         @db.ObjectId
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score   Float
  remarks String?

  markedBy String   @db.ObjectId
  markedAt DateTime @default(now())

  @@unique([examId, studentId])
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
}

model Assignment {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime

  classId String @db.ObjectId
  class   Class  @relation(fields: [classId], references: [id])

  subject  String
  maxScore Float

  submissions AssignmentSubmission[]

  createdBy String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssignmentSubmission {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignmentId String     @db.ObjectId
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String         @db.ObjectId
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status   SubmissionStatus @default(PENDING)
  content  String? // URL or text
  score    Float?
  feedback String?

  submittedAt DateTime?
  gradedBy    String?   @db.ObjectId
  gradedAt    DateTime?

  @@unique([assignmentId, studentId])
}

enum AnnouncementRole {
  ALL
  TEACHER
  STUDENT
  PARENT
  ADMIN
}

model Announcement {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String @db.ObjectId
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title      String
  content    String
  targetRole AnnouncementRole @default(ALL)

  createdBy  String  @db.ObjectId
  authorName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalaryPayment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  month     Int
  year      Int
  status    String // PAID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  category  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
